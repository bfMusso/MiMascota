# Copiá este archivo como infra/.env y completá los valores.

# Base de datos
DB_NAME=mimascota
DB_USER=mimascota
DB_PASSWORD=cambiame

# Primer administrador (se crea al arrancar si no existe)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Puertos en tu máquina. Elegidos para no chocar con otros proyectos
# (evitan 3000, 5173, 5432, 8000, 8080 y 80). Cambialos acá si alguno está ocupado.
DB_PORT=5440
BACKEND_PORT=8090
WEB_PORT=8085
