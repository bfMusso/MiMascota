# Copiá este archivo como infra/.env y completá los valores.

# Base de datos
DB_NAME=mimascota
DB_USER=mimascota
DB_PASSWORD=cambiame

# Primer administrador (se crea al arrancar si no existe)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Clave para firmar los tokens de sesión (JWT). Obligatoria, al menos 32 caracteres.
# Generá una con: openssl rand -base64 48   (o cualquier texto largo y aleatorio)
JWT_SECRET=

# En local la web corre en http, así que la cookie de sesión va sin "Secure".
# En el servidor con HTTPS poné true.
COOKIE_SECURE=false

# Dirección pública de la web, para armar la URL de cada placa (QR y NFC) en el CSV de lotes.
# En local no hace falta: usa http://localhost:5180 (o 8085 en modo completo). En el servidor, tu dominio.
# WEB_URL=https://mimascota.uy

# Correo. En local se usa Mailpit (ver http://localhost:8030); en producción, el proveedor SMTP real.
MAIL_FROM=MiMascota <no-reply@mimascota.local>
# MAIL_HOST=smtp.proveedor.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true

# Puertos en tu máquina. Elegidos para no chocar con otros proyectos
# (evitan 80, 1025, 3000, 5173, 5432-5434, 8000, 8025, 8080 y 8081). Cambialos acá si alguno está ocupado.
DB_PORT=5440
BACKEND_PORT=8090
WEB_PORT=8085
MAILPIT_SMTP_PORT=1030
MAILPIT_WEB_PORT=8030
